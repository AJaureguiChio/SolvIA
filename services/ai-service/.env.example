PORT=8000

# Umbral de similitud coseno para aceptar un match (lo calibras en el Hito 3).
# Placeholder; NO lo dejes así en la entrega, justifícalo con datos del equipo.
MATCH_THRESHOLD=0.40

# Confianza mínima del detector para aceptar una cara (0-1).
# El detector (MTCNN) da ~0.99 en caras claras y de frente.
MIN_DET_SCORE=0.90

# Lado mínimo del bounding box en píxeles para considerar la cara "usable".
MIN_FACE_PX=80

# Cuántos embeddings guardar por persona en el enrollment.
EMBEDDINGS_PER_USER=4

# Ruta del archivo donde se persisten los embeddings en desarrollo (Hito 5).
STORE_PATH=./data/embeddings.npz
