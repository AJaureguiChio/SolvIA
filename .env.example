# Copia este archivo como .env en la raíz del repositorio y rellena los valores.
# El backend, el microservicio facial y Vite (envDir: '..') leen este mismo archivo.

# ── Base de datos (Neon) ─────────────────────────────────────────────
# Conexión con pooler, usada por el backend.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Conexión directa, usada por las migraciones y el seed.
DATABASE_URL_UNPOOLED=postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full
# Los scripts db:migrate y db:seed solo corren si vale "desarrollo".
NEON_BRANCH=desarrollo

# ── Neon Auth ────────────────────────────────────────────────────────
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json

# ── Backend ──────────────────────────────────────────────────────────
# Orígenes permitidos por CORS, separados por comas.
FRONTEND_ORIGIN=http://localhost:5173
# Opcional, por defecto 3000.
PORT=3000

# ── Frontend (Vite; estas variables terminan en el bundle: nada secreto) ─
VITE_NEON_AUTH_URL=${NEON_AUTH_BASE_URL}
VITE_API_URL=http://localhost:3000/api/v1

# ── Verificación facial ──────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Clave compartida backend ↔ microservicio (header X-Internal-Key).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_INTERNAL_KEY=
# Clave AES-256 de las galerías faciales: 32 bytes en base64. Si se pierde, hay que registrar los rostros de nuevo.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FACE_GALLERY_KEY=
# Firma de la cookie solvia_face.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FACE_JWT_SECRET=
# Opcionales del microservicio: similitud coseno mínima y lado mínimo del rostro en píxeles.
# FACE_THRESHOLD=0.60
# FACE_MIN_SIZE=80
# Opcional: "true" para SameSite=None; Secure cuando frontend y backend están en dominios distintos.
# FACE_COOKIE_SECURE=false

# ── Reportes con IA (Gemini) ─────────────────────────────────────────
GEMINI_API_KEY=
# Opcionales.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL_RESPALDO=gemini-2.5-flash

# ── Almacenamiento (aún no se usa en el código) ──────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
